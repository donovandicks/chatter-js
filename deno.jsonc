{
  "tasks": {
    "fmt": {
      "description": "Apply formatting rules.",
      "command": "deno fmt"
    },
    "fmt::check": {
      "description": "Run format checks.",
      "command": "deno fmt --check"
    },
    "lint": {
      "description": "Run format and lint checks.",
      "command": "deno lint",
      "dependencies": [
        "fmt::check"
      ]
    },
    "test::unit": {
      "description": "Run unit tests.",
      "command": "deno test --no-check -A ./tests/unit/"
    },
    "prebuild": {
      "description": "Run format, lint, and type checks.",
      "command": "deno check",
      "dependencies": [
        "lint"
      ]
    },
    "build": {
      "description": "Compile the application.",
      "command": "deno compile -A -o ./chatter-js src/main.ts",
      "dependencies": [
        "prebuild"
      ]
    }
  },
  "imports": {
    "@google/genai": "npm:@google/genai@^1.38.0",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/async": "jsr:@std/async@^1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "@std/testing": "jsr:@std/testing@^1",
    "zod": "npm:zod@^4.3.6"
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  }
}
