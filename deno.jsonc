{
  "tasks": {
    "dev": {
      "command": "OTEL_DENO=true deno run -A ./src/main.tsx"
    },
    "fmt": {
      "description": "Apply formatting rules.",
      "command": "deno fmt"
    },
    "fmt::check": {
      "description": "Run format checks.",
      "command": "deno fmt --check"
    },
    "lint": {
      "description": "Run format and lint checks.",
      "command": "deno lint",
      "dependencies": [
        "fmt::check"
      ]
    },
    "test::unit": {
      "description": "Run unit tests.",
      "command": "deno test --no-check --allow-read ./tests/unit/"
    },
    "prebuild": {
      "description": "Run format, lint, and type checks.",
      "command": "deno check",
      "dependencies": [
        "lint"
      ]
    },
    "build": {
      "description": "Compile the application.",
      "command": "OTEL_DENO=true deno compile -A -o ./chatter-js src/main.tsx",
      "dependencies": [
        "prebuild"
      ]
    },
    "build::quick": {
      "description": "Compile the application without prechecks.",
      "command": "OTEL_DENO=true deno compile -A -o ./chatter-js src/main.tsx"
    },
    "clean": {
      "description": "Remove all compiled binaries and generated files.",
      "command": "rm ./chatter-js"
    },
    "lgtm:start": {
      "description": "Start the observability container.",
      "command": "docker compose up -d"
    },
    "lgtm:stop": {
      "description": "Stop the observability container.",
      "command": "docker compose down --remove-orphans"
    }
  },
  "imports": {
    "@google/genai": "npm:@google/genai@^1.39.0",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.0",
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "@std/async": "jsr:@std/async@^1.1.1",
    "@std/cli": "jsr:@std/cli@^1.0.27",
    "@std/datetime": "jsr:@std/datetime@^0.225.7",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "@std/fmt": "jsr:@std/fmt@^1.0.9",
    "@std/fs": "jsr:@std/fs@^1.0.22",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "@std/yaml": "jsr:@std/yaml@^1.0.11",
    "ink": "npm:ink@^6.6.0",
    "ink-scroll-view": "npm:ink-scroll-view@^0.3.5",
    "ink-spinner": "npm:ink-spinner@^5.0.0",
    "ink-text-input": "npm:ink-text-input@^6.0.0",
    "react": "npm:react@^19.2.4",
    "@types/react": "npm:@types/react@^19.2.10",
    "zod": "npm:zod@^4.3.6"
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  },
  "unstable": [
    "temporal"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "types": [
      "react",
      "react-dom",
      "@types/react"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "exclude": [
    "lgtm/"
  ]
}
